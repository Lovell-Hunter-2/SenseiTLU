rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "taikhoanphubg4@gmail.com" ||
        request.auth.token.email == "ngominhthuanbg1612007@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /{path=**}/activities/{activityId} {
      allow read: if isAdmin();
    }

    match /error_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.keys().hasAll(['email', 'role']) &&
                    (request.resource.data.role == 'user' || isAdmin());
      allow update: if isAdmin() || (isOwner(userId) && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();

      match /activities/{activityId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId);
        allow delete: if isAdmin();
      }
    }

    match /subjects/{subjectId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /documents/{documentId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /blog/{blogId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || (isAuthenticated() && request.resource.data.authorId == request.auth.uid && exists(/databases/$(database)/documents/settings/blog) && get(/databases/$(database)/documents/settings/blog).data.allowPublicPosting == true);
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.authorId == request.auth.uid);

      match /reactions/{userId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId) || isAdmin();
      }

      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
        allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      }
    }

    match /quizzes/{quizId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /analytics/{docId} {
      allow read, delete: if isAdmin();
      allow create, update: if request.resource.data.keys().hasOnly(['visits', 'date', 'hour', 'lastUpdated']) &&
                            (!request.resource.data.keys().hasAny(['visits']) || request.resource.data.visits is number) &&
                            (!request.resource.data.keys().hasAny(['date']) || request.resource.data.date is string) &&
                            (!request.resource.data.keys().hasAny(['hour']) || request.resource.data.hour is string);
    }

    match /analytics_subjects/{docId} {
      allow read, delete: if isAdmin();
      allow create, update: if request.resource.data.keys().hasOnly(['name', 'views', 'lastUpdated']) &&
                            (!request.resource.data.keys().hasAny(['views']) || request.resource.data.views is number) &&
                            (!request.resource.data.keys().hasAny(['name']) || request.resource.data.name is string);
    }

    match /analytics_documents/{docId} {
      allow read, delete: if isAdmin();
      allow create, update: if request.resource.data.keys().hasOnly(['title', 'subjectName', 'views', 'lastUpdated']) &&
                            (!request.resource.data.keys().hasAny(['views']) || request.resource.data.views is number) &&
                            (!request.resource.data.keys().hasAny(['title']) || request.resource.data.title is string) &&
                            (!request.resource.data.keys().hasAny(['subjectName']) || request.resource.data.subjectName is string);
    }

    match /reports/{reportId} {
      allow read, delete: if isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        (request.resource.data.keys().hasAll(['title', 'message', 'type', 'createdAt']) && request.resource.data.userId == request.auth.uid) ||
        (request.resource.data.keys().hasAll(['title', 'message', 'forAdminOnly', 'createdAt']))
      );
      allow update, delete: if isAdmin();
    }
  }
}
